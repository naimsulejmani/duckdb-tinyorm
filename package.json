{
  "name": "duckdb-tinyorm",
  "version": "4.0.0",
  "description": "TinyORM for Duckdb, easy setup",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run test:types && node --require ./tests/register.js --test --test-reporter=spec tests/memory.test.ts tests/file.test.ts",
    "dev": "node --watch --require ts-node/register src/test.ts",
    "start": "node dist/index.js",
    "release": "node scripts/release.js",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naimsulejmani/duckdb-tinyorm.git"
  },
  "keywords": [
    "duckdb",
    "orm",
    "tinyorm",
    "database"
  ],
  "author": "Naim Sulejmani",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/naimsulejmani/duckdb-tinyorm/issues"
  },
  "homepage": "https://github.com/naimsulejmani/duckdb-tinyorm#readme",
  "peerDependencies": {
    "@duckdb/node-api": "^2.0.0-r.1"
  },
  "devDependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "globals": "^17.14.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
